# Django Environment Variables Template
# Copy this file to .env and configure your secret values.

DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=rezapython.ir,www.rezapython.ir,localhost,127.0.0.1

# Telegram Notification Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
